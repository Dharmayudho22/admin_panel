<!DOCTYPE html>
<html>
<head>
  <title>Tambah Kategori</title>
</head>
<body>

<h1>Tambah Kategori</h1>

<form
  action="/kategori/create"
  method="POST"
>
  <input
    type="text"
    name="name"
    placeholder="Nama kategori"
  />

  <br><br>

  <textarea
    name="description"
    placeholder="Deskripsi"
  ></textarea>

  <br><br>

  <button type="submit">
    Simpan
  </button>
</form>

</body>
</html>